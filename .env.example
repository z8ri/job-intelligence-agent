# Copy this file to .env and fill in real values. .env is gitignored.

# Required — used for query understanding, reranking, dense embeddings, and answer generation.
OPENAI_API_KEY=sk-...

# MySQL connection (defaults shown; override only what differs on your machine).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_intelligence
